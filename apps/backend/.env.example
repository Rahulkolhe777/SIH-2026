# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend Email Service
# Get an API key from https://resend.com
RESEND_API_KEY=re_123456789
EMAIL_FROM=onboarding@resend.dev
